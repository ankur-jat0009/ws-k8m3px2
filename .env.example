# WindScope Environment Configuration Example
# Backend Port
PORT=8000

# Elexon BMRS API Base URL
ELEXON_API_BASE=https://data.elexon.co.uk/bmrs/api/v1

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# Fallback / Offline Demo Mode (false = use real Elexon data)
DEMO_MODE=false

# Timeouts in seconds
HTTP_TIMEOUT_SECONDS=30.0
HTTP_MAX_RETRIES=3

# Frontend Production API URL (leave empty when using reverse proxy)
VITE_API_URL=
